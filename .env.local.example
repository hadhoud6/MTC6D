# Copy to .env.local for local testing. Never commit real values.
# On the host (Manus preview / Vercel), set the same names in the
# project's environment-variable settings and redeploy.

# --- Email (Resend, free tier) ---
RESEND_API_KEY=re_...

# Test mode (no verified domain yet): send only to the Resend account
# owner's email, from Resend's test sender. Remove these two lines
# (or point FORM_OWNER_EMAIL at the client mailbox) once the client
# domain is verified in Resend and SPF/DKIM/DMARC DNS records are live.
FORM_OWNER_EMAIL=
RESEND_FROM_EMAIL=onboarding@resend.dev

# --- Server Actions behind a proxy (preview only) ---
# Next.js rejects Server Actions when the Origin header does not match
# the forwarded host, which happens on previews behind a proxy (Manus).
# Only set this for a preview host. Comma-separated hosts, wildcards
# allowed. Leave unset in production, where host and origin match.
# SERVER_ACTIONS_ALLOWED_ORIGINS=*.*.manus.computer

# --- File uploads (Vercel Blob) ---
# Only required when a form includes a file. The current code returns
# an "upload/config" error for file submissions if this is missing.
BLOB_READ_WRITE_TOKEN=

# --- Saved copy (Google Sheets, free) ---
# See GOOGLE_SHEETS_SETUP.md. If these three are missing, the forms
# fall back to email-only delivery (the previous behaviour).
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Optional tab names (defaults: Devis / Contact)
# GOOGLE_SHEETS_DEVIS_TAB=Devis
# GOOGLE_SHEETS_CONTACT_TAB=Contact
